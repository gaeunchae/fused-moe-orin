+        nchannels_y, stride_channel_y, stride_channel_dst, pf_blocks);
+}
+
+// Single token MoE down for short rows. A group of qi/vdr lanes owns a row and walks all its blocks,
+// so no lane idles and the sum needs no shared memory.
+template <ggml_type type, int nwarps, int rows_per_group, int blocks_per_row>
+__launch_bounds__(nwarps*ggml_cuda_get_physical_warp_size(), 1)
+static __global__ void mul_mat_vec_q_moe_short_rows(
+        const void * __restrict__ vx, const void * __restrict__ vy, const int32_t * __restrict__ ids, float * __restrict__ dst,
+        const int stride_row_x, const int stride_channel_x, const int nchannels_y, const int stride_channel_y,
+        const int stride_channel_dst) {
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size       = ggml_cuda_get_physical_warp_size();
+    constexpr int lanes_per_row   = qi/vdr;
+    constexpr int groups_per_warp = warp_size/lanes_per_row;
+    static_assert(warp_size % lanes_per_row == 0, "a row group must fit in a warp");
+
+    constexpr vec_dot_q_cuda_t vec_dot_q_cuda = get_vec_dot_q_cuda(type);
+
+    const int lane  = threadIdx.x % lanes_per_row;
+    const int group = threadIdx.y*groups_per_warp + threadIdx.x/lanes_per_row;
+    const int row0  = (blockIdx.x*nwarps*groups_per_warp + group)*rows_per_group;
+
+    ggml_cuda_pdl_sync();
+    const int channel_x = ids[blockIdx.y];
+    if (channel_x < 0) {
+        return;
+    }
+
+    const block_q8_1 * y = (const block_q8_1 *) vy + (blockIdx.y % nchannels_y)*stride_channel_y;
+    const int kbx_offset = channel_x*stride_channel_x + row0*stride_row_x;
+
+    float tmp[rows_per_group] = {0.0f};
+
+#pragma unroll
+    for (int kbx = 0; kbx < blocks_per_row; ++kbx) {
+#pragma unroll
+        for (int i = 0; i < rows_per_group; ++i) {
+            tmp[i] += vec_dot_q_cuda(vx, &y[kbx*(qk/QK8_1)], kbx_offset + i*stride_row_x + kbx, vdr*lane);
+        }
+    }
+
+    dst += blockIdx.y*stride_channel_dst + row0;
+
+#pragma unroll
+    for (int i = 0; i < rows_per_group; ++i) {
+        tmp[i] = warp_reduce_sum<lanes_per_row>(tmp[i]);
+        if (lane == 0) {
+            dst[i] = tmp[i];
+        }
+    }
+}
+
+static constexpr int mmvq_moe_short_rows_nwarps         = 2;
+static constexpr int mmvq_moe_short_rows_rows_per_group = 2;
+
+template <ggml_type type>
+static int mul_mat_vec_q_moe_short_rows_rows_per_block(const int warp_size) {
+    constexpr int lanes_per_row = ggml_cuda_type_traits<type>::qi / get_vdr_mmvq(type);
+    return mmvq_moe_short_rows_nwarps * (warp_size/lanes_per_row) * mmvq_moe_short_rows_rows_per_group;
+}
+
+static bool mul_mat_vec_q_moe_short_rows_supported(const ggml_tensor * src0, const ggml_tensor * ids, const int64_t ncols_dst,
+        const ggml_cuda_mm_fusion_args_device & fusion, const int cc, const int warp_size) {
+    static const bool enabled = [] {
+        const char * env = getenv("GGML_CUDA_MOE_DOWN");
+        return env == nullptr || std::atoi(env) != 0;
+    }();
+    if (!enabled || !ids || ncols_dst != 1 || src0->ne[3] != 1 || fusion.gate || fusion.x_bias || fusion.shared_up ||
+            !GGML_CUDA_CC_IS_NVIDIA(cc) || (get_device_table_id(cc) != MMVQ_PARAMETERS_GENERIC && get_device_table_id(cc) != MMVQ_PARAMETERS_ORIN)) {
+        return false;
+    }
+    int rows_per_block;
+    switch (src0->type) {
+        case GGML_TYPE_Q4_K: rows_per_block = mul_mat_vec_q_moe_short_rows_rows_per_block<GGML_TYPE_Q4_K>(warp_size); break;
+        case GGML_TYPE_Q6_K: rows_per_block = mul_mat_vec_q_moe_short_rows_rows_per_block<GGML_TYPE_Q6_K>(warp_size); break;
+        default: return false;
+    }
+    const int64_t blocks_per_row = src0->ne[0] / ggml_blck_size(src0->type);
+    return blocks_per_row >= 2 && blocks_per_row <= 4 && src0->ne[1] % rows_per_block == 0;
+}
