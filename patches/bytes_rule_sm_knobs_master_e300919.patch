+// Single token MoE up and gate for Q4_K with SwiGLU. Each block also prefetches into L2 the rows of the block
+// pf_blocks later in launch order. This hides DRAM latency when small blocks limit occupancy (Jetson Orin).
+// 8 blocks per SM keep registers at 64 or less; at 71 only 7 blocks fit and the kernel runs ~11% slower on Orin.
+template <int nwarps, int rows_per_block>
+__launch_bounds__(nwarps*ggml_cuda_get_physical_warp_size(), 8)
+static __global__ void mul_mat_vec_q4_K_moe_swiglu(
+        const void * __restrict__ vx, const void * __restrict__ vgate, const void * __restrict__ vy,
+        const int32_t * __restrict__ ids, float * __restrict__ dst,
+        const int ncols_x, const int nrows_x, const int stride_row_x, const int stride_channel_x,
+        const int nchannels_y, const int stride_channel_y, const int stride_channel_dst, const int pf_blocks) {
+    constexpr ggml_type type = GGML_TYPE_Q4_K;
+    constexpr int qk  = ggml_cuda_type_traits<type>::qk;
+    constexpr int qi  = ggml_cuda_type_traits<type>::qi;
+    constexpr int vdr = get_vdr_mmvq(type);
+    constexpr int warp_size = ggml_cuda_get_physical_warp_size();
+    constexpr int blocks_per_iter = vdr * nwarps*warp_size / qi;
+
+    const int tid  = warp_size*threadIdx.y + threadIdx.x;
+    const int row0 = rows_per_block*blockIdx.x;
+    const int blocks_per_row_x = ncols_x / qk;
+
+    ggml_cuda_pdl_sync();
+    const int channel_x = ids[blockIdx.y];
+    if (channel_x < 0) {
+        return;
+    }
+
+    if (pf_blocks > 0) {
+        const int next = blockIdx.y*gridDim.x + blockIdx.x + pf_blocks;
+        const int next_y = next / gridDim.x;
+        if (next_y < (int) gridDim.y && ids[next_y] >= 0) {
+            const int next_x = next - next_y*gridDim.x;
+            const size_t offset = ((size_t) ids[next_y]*stride_channel_x + (size_t) rows_per_block*next_x*stride_row_x) * sizeof(block_q4_K);
+            const size_t first  = offset & ~(size_t) 127;
+            const int nlines = (offset + (size_t) rows_per_block*stride_row_x*sizeof(block_q4_K) - first + 127) / 128;
+            for (int l = tid; l < 2*nlines; l += nwarps*warp_size) {
+                const char * base = (const char *) (l < nlines ? vx : vgate);
+                ggml_cuda_prefetch_l2(base + first + (size_t) (l % nlines)*128);
+            }
+        }
+    }
+
+    const block_q8_1 * y = (const block_q8_1 *) vy + (blockIdx.y % nchannels_y)*stride_channel_y;
+    const int kbx_offset = channel_x*stride_channel_x + row0*stride_row_x;
+
+    float tmp[rows_per_block]      = {0.0f};
+    float tmp_gate[rows_per_block] = {0.0f};
+
+    for (int kbx = tid / (qi/vdr); kbx < blocks_per_row_x; kbx += blocks_per_iter) {
+        const int kby = kbx * (qk/QK8_1);
+        const int kqs = vdr * (tid % (qi/vdr));
+
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            tmp[i]      += vec_dot_q4_K_q8_1(vx,    &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+            tmp_gate[i] += vec_dot_q4_K_q8_1(vgate, &y[kby], kbx_offset + i*stride_row_x + kbx, kqs);
+        }
+    }
+
+    __shared__ float tmp_shared[nwarps-1 > 0 ? nwarps-1 : 1][rows_per_block][warp_size];
+    __shared__ float tmp_shared_gate[nwarps-1 > 0 ? nwarps-1 : 1][rows_per_block][warp_size];
+    if (threadIdx.y > 0) {
+#pragma unroll
+        for (int i = 0; i < rows_per_block; ++i) {
+            tmp_shared[threadIdx.y-1][i][threadIdx.x]      = tmp[i];
+            tmp_shared_gate[threadIdx.y-1][i][threadIdx.x] = tmp_gate[i];
+        }
+    }
+    __syncthreads();
+    if (threadIdx.y > 0) {
+        return;
+    }
+
+    dst += blockIdx.y*stride_channel_dst + row0;
+
+#pragma unroll
+    for (int i = 0; i < rows_per_block; ++i) {
+#pragma unroll
+        for (int l = 0; l < nwarps-1; ++l) {
+            tmp[i]      += tmp_shared[l][i][threadIdx.x];
+            tmp_gate[i] += tmp_shared_gate[l][i][threadIdx.x];
+        }
+        tmp[i]      = warp_reduce_sum<warp_size>(tmp[i]);
+        tmp_gate[i] = warp_reduce_sum<warp_size>(tmp_gate[i]);
+
+        if (threadIdx.x == i && row0 + i < nrows_x) {
+            dst[i] = tmp[i] * ggml_cuda_op_silu_single(tmp_gate[i]);
+        }
+    }
+}
