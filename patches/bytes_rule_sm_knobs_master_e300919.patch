+// Experimental bytes-based block shape for single-token GEMV, on when GGML_CUDA_MMVQ_BYTES sets a target number of
+// weight bytes per block (8192 measured best on Jetson Orin). One warp when a row needs at most 32 lanes, else two.
+// Rows per block grow until the block reads the target bytes, counting gate and up when both are read, while each
+// thread keeps at most 4 partial sums. The fused template holds a gate sum per row even when only a bias is fused,
+// so it counts as 2 sums per row: more sums cost registers, fewer blocks fit on an SM, and the fused gate+up kernel
+// got up to 39% slower. On Orin the speed follows these bytes, not the row length.
+static int mmvq_bytes_target() {
+    static const int target = [] {
+        const char * s = getenv("GGML_CUDA_MMVQ_BYTES");
+        return s ? atoi(s) : 0;
+    }();
+    return target;
+}
+
+// Experiment for GPUs with many SMs: GGML_CUDA_MMVQ_MAXNW=4 lets rows of more than 2 warps of lanes use 4 warps,
+// GGML_CUDA_MMVQ_MINBLK=n halves rows per block until the grid has at least n blocks per SM. Unset = rule as above.
+static int mmvq_max_nwarps() {
+    static const int v = [] {
+        const char * s = getenv("GGML_CUDA_MMVQ_MAXNW");
+        return s && atoi(s) >= 4 ? 4 : 2;
+    }();
+    return v;
+}
+
+static int mmvq_min_blocks_per_sm() {
+    static const int v = [] {
+        const char * s = getenv("GGML_CUDA_MMVQ_MINBLK");
+        return s ? atoi(s) : 0;
+    }();
+    return v;
+}
+
+// Experiment only: GGML_CUDA_MMVQ_SHAPE="warps,rows" forces one block shape (warps 1, 2 or 4; rows 1, 2, 4 or 8)
+// for the same types, so shapes can be compared on the real kernels.
+static int2 mmvq_forced_shape() {
+    static const int2 shape = [] {
+        int nw = 0, rows = 0;
+        const char * s = getenv("GGML_CUDA_MMVQ_SHAPE");
+        if (s && sscanf(s, "%d,%d", &nw, &rows) == 2 && (nw == 1 || nw == 2 || nw == 4) &&
+                (rows == 1 || rows == 2 || rows == 4 || rows == 8)) {
+            return make_int2(nw, rows);
+        }
+        return make_int2(0, 0);
+    }();
+    return shape;
+}
+
+// Types measured with the bytes-based shape; others keep the table to bound the number of kernel instances.
+static constexpr bool mmvq_bytes_shape_type(ggml_type type) {
+    switch (type) {
+        case GGML_TYPE_Q4_0:
+        case GGML_TYPE_Q4_1:
+        case GGML_TYPE_Q5_0:
+        case GGML_TYPE_Q5_1:
+        case GGML_TYPE_Q8_0:
+        case GGML_TYPE_MXFP4:
+        case GGML_TYPE_Q2_K:
+        case GGML_TYPE_Q3_K:
+        case GGML_TYPE_Q4_K:
+        case GGML_TYPE_Q5_K:
+        case GGML_TYPE_Q6_K:
+        case GGML_TYPE_IQ4_NL:
+        case GGML_TYPE_IQ4_XS:
+            return true;
+        default:
+            return false;
+    }
+}
